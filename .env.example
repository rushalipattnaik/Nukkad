# =============================================================================
# Nukkad - environment configuration
# =============================================================================
# Copy this file to ".env" in the project root and fill in your keys.

# ---- Required ---------------------------------------------------------------
# Get one at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Leave blank if unsure. Run scripts/verify_api_setup.py first - it lists
# which models your key can use and recommends one. Nukkad works fine with
# no Gemini configured too: it falls back to non-LLM summaries.
GEMINI_MODEL=

# ---- App behaviour (safe defaults - change only if you know why) -----------
NUKKAD_ENV=development
NUKKAD_DATABASE_URL=sqlite:///./nukkad.db
NUKKAD_ALLOWED_ORIGINS=http://localhost:5173

# ---- Credit protection --------------------------------------------------
# Hard ceiling on SerpApi searches per calendar day, across ALL scans.
# Protects your plan if this is ever exposed publicly. 300 is a safe default
# for a 10,000-credit plan; lower it if you want to be more conservative.
NUKKAD_DAILY_CREDIT_CAP=300

# Absolute ceiling any single scan can ever use, regardless of preset.
NUKKAD_MAX_SCAN_CREDITS=150

# Per-preset credit caps shown in the UI's scan-depth selector.
NUKKAD_LITE_SCAN_CREDITS=40
NUKKAD_STANDARD_SCAN_CREDITS=90
NUKKAD_DEEP_SCAN_CREDITS=150

# How many scans one IP address may start per hour (protects your credits
# from accidental double-clicks or a runaway script).
NUKKAD_SCAN_RATE_LIMIT_PER_HOUR=6
NUKKAD_RATE_LIMIT_PER_MINUTE=20